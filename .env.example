PORT=3000
NODE_ENV=development

# PostgreSQL connection string. If omitted, falls back to a local default
# (postgres://postgres:PostgresLocal123!@localhost:5432/helpdesk) for dev.
# On Render, attach a PostgreSQL database to this service and it will set
# DATABASE_URL automatically.
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/helpdesk

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Seed account created automatically on first run if no Super Admin exists yet.
# Log in with these, then change the password immediately from the Users page.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Public base URL of this app, used to build the link inside verification
# emails. Set this to your real domain/Render URL in production.
APP_URL=http://localhost:3000

# Gmail account used to send email verification links via SMTP.
# GMAIL_USER is the full Gmail address. GMAIL_APP_PASSWORD is a 16-character
# App Password (requires 2-Step Verification enabled on the Google account) -
# generate one at https://myaccount.google.com/apppasswords
# If left unset, verification links are logged to the server console instead
# of emailed (useful for local development).
GMAIL_USER=
GMAIL_APP_PASSWORD=
