PORT=3000
NODE_ENV=development

# PostgreSQL connection string. If omitted, falls back to a local default
# (postgres://postgres:PostgresLocal123!@localhost:5432/helpdesk) for dev.
# On Render, attach a PostgreSQL database to this service and it will set
# DATABASE_URL automatically.
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/helpdesk

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Seed account created automatically on first run if no Super Admin exists yet.
# Log in with these, then change the password immediately from the Users page.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Public base URL of this app, used to build the link inside verification
# emails. Set this to your real domain/Render URL in production.
APP_URL=http://localhost:3000

# SMTP settings used to send email verification links. Works with any
# provider: your company mail server, Outlook/Office365, Yahoo, a transactional
# service's SMTP relay (SendGrid, Mailgun, Postmark, Amazon SES, etc), or Gmail.
# SMTP_PORT defaults to 587. SMTP_SECURE defaults to true only when the port is
# 465; set it explicitly to override. EMAIL_FROM is the address verification
# emails appear to come from; if left unset it falls back to SMTP_USER.
# If SMTP_HOST is left unset, verification links are logged to the server
# console instead of emailed (useful for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Back-compat: if SMTP_HOST is unset, these are used instead (Gmail only).
# GMAIL_APP_PASSWORD is a 16-character App Password (requires 2-Step
# Verification enabled on the Google account) - generate one at
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
